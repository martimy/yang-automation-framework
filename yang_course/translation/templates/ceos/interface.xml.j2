<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0"> <!--important-->
  <interfaces xmlns="http://openconfig.net/yang/interfaces">
    {% for iface in interfaces %}
    <interface>
      <name>{{ iface.name }}</name>
      <config>
        <name>{{ iface.name }}</name>
        <description>{{ iface.description }}</description>
        <enabled>{{ iface.enabled | lower }}</enabled>
        <type xmlns:ianaift="urn:ietf:params:xml:ns:yang:iana-if-type">
          ianaift:ethernetCsmacd
        </type>
      </config>
      <subinterfaces>
        <subinterface>
          <index>0</index>
          <config>
            <index>0</index>
          </config>
          <ipv4 xmlns="http://openconfig.net/yang/interfaces/ip">
            <addresses>
              <address>
                <ip>{{ iface.ip_address }}</ip>
                <config>
                  <ip>{{ iface.ip_address }}</ip>
                  <prefix-length>{{ iface.prefix_length }}</prefix-length>
                </config>
              </address>
            </addresses>
          </ipv4>
        </subinterface>
      </subinterfaces>
    </interface>
    {% endfor %}
  </interfaces>
</config>
