# Copy this file to .env and adjust if you change the lab's default credentials.
# These are the well-known containerlab/vendor lab defaults (cEOS: admin/admin,
# SR Linux: admin/NokiaSrl1!) — fine for this local sandbox, but never reuse
# default credentials like these outside of an isolated lab.
CEOS_PASSWORD=admin
SRL_PASSWORD=NokiaSrl1!
