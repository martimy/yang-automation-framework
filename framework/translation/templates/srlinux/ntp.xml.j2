<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <system xmlns="http://openconfig.net/yang/system">
    <ntp>
      <config>
        <enabled>{{ enabled | lower }}</enabled>
      </config>
      <servers>
        {% for server in servers %}
        <server>
          <address>{{ server.host }}</address>
          <config>
            <address>{{ server.host }}</address>
            <source-address>{{ server.source }}</source-address> 
            <network-instance>{{ server.network_instance }}</network-instance>
          </config>
        </server>
        {% endfor %}
      </servers>
    </ntp>
  </system>
</config>
